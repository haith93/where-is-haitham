# =====================================================================
#  Where Is Haitham Now?  --  example environment
#
#  The frontend is a static site, so these values are injected into
#  js/env.js at deploy time (see .github/workflows/deploy.yml) or copied
#  by hand from js/env.example.js during local development.
#
#  Add the first two as GitHub repository secrets:
#    Settings -> Secrets and variables -> Actions -> New repository secret
# =====================================================================

# Supabase -> Project Settings -> API -> Project URL
SUPABASE_URL=https://cjvwwncaftkzbbpwugdi.supabase.co

# Supabase -> Project Settings -> API -> anon public key.
# Safe for the browser: every table is protected by Row Level Security.
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImNqdnd3bmNhZnRremJicHd1Z2RpIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODkzMDUzNDksImV4cCI6MjEwNDg4MTM0OX0.hcHB0bPSSEqormAuYke-W5xuUYtfmQDKd9CWXbQ55ws
# Optional. Public half of your VAPID key pair, for Web Push.
# Leave empty to run without push; in-app alerts still work.
VAPID_PUBLIC_KEY=

# =====================================================================
#  SERVER SIDE ONLY -- never add these to GitHub Pages or to js/env.js.
#  Set them as Supabase Edge Function secrets:
#    supabase secrets set VAPID_PRIVATE_KEY=... VAPID_SUBJECT=... PUSH_WEBHOOK_SECRET=...
# =====================================================================
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:it@example.com
# PUSH_WEBHOOK_SECRET=
#
# SUPABASE_SERVICE_ROLE_KEY must NEVER appear in this repository.
